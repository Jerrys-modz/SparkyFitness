{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "env": {
        "APP_VARIANT": "development"
      },
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "env": {
        "APP_VARIANT": "preview"
      },
      "distribution": "internal"
    },
    "testflight": {
      "environment": "preview",
      "env": {
        "APP_VARIANT": "development"
      },
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "medium"
      }
    },
    "production": {
      "env": {
        "APP_VARIANT": "production"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "medium"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6757314392"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6817477965"
      }
    }
  }
}
